<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7A8C4">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:padding="5dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Instructor Dashboard"
                android:textColor="#AC1754"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_centerVertical="true"/>

            <ImageButton
                android:id="@+id/btnTeacherProfile"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:layout_alignParentEnd="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_teacher_profile"
                app:tint="#AC1754" />
        </RelativeLayout>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="8dp"
            app:cardBackgroundColor="#F2FFFFFF"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Your Profile Info"
                    android:textColor="#AC1754"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:layout_marginBottom="12dp"
                    android:layout_gravity="start"/>

                <de.hdodenhof.circleimageview.CircleImageView
                    android:id="@+id/ivTeacherProfile"
                    android:layout_width="90dp"
                    android:layout_height="90dp"
                    android:layout_marginBottom="10dp"
                    android:src="@android:drawable/ic_menu_gallery"
                    app:civ_border_color="#AC1754"
                    app:civ_border_width="2dp"/>

                <TextView android:id="@+id/tvName" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Name: Loading..." android:textSize="18sp" android:textStyle="bold" android:textColor="#212121"/>
                <TextView android:id="@+id/tvEmail" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Email: Loading..." android:layout_marginTop="4dp" android:textColor="#424242"/>
                <TextView android:id="@+id/tvQualifications" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Qual: Loading..." android:layout_marginTop="4dp" android:textColor="#424242"/>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="8dp"
            app:cardBackgroundColor="#F2FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Publish New Art Video"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#AC1754"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Select Course Category:"
                    android:textSize="12sp"
                    android:textColor="#AC1754"
                    android:layout_marginBottom="4dp"/>

                <Spinner
                    android:id="@+id/spnArtType"
                    android:layout_width="match_parent"
                    android:layout_height="45dp"
                    android:layout_marginBottom="16dp"
                    android:background="@android:drawable/btn_dropdown"
                    android:backgroundTint="#E53888"/>

                <Button
                    android:id="@+id/btnSelectVideo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="CHOOSE VIDEO FILE"
                    android:backgroundTint="#6200EE"
                    android:textColor="#FFFFFF" />

                <EditText
                    android:id="@+id/etArtName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Art Title (e.g. Master Shading)"
                    android:layout_marginTop="16dp"
                    android:padding="12dp"
                    android:background="@android:drawable/editbox_background"/>

                <EditText
                    android:id="@+id/etVideoDetails"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Video Description / Steps"
                    android:layout_marginTop="12dp"
                    android:padding="12dp"
                    android:background="@android:drawable/editbox_background"/>

                <Button
                    android:id="@+id/btnUpload"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="UPLOAD NOW"
                    android:layout_marginTop="20dp"
                    android:backgroundTint="#E53888"
                    android:textColor="#FFFFFF" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>